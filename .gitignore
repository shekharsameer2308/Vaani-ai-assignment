# ---- Python environments ----
venv/
.venv/
env/
ENV/

# ---- Python build and cache ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
.groq.key
secrets/

# ---- Runtime logs ----
logs/
*.log

# ---- Built artifacts (rebuilt by scripts) ----
data/*.pkl
data/*.faiss
*.pkl

# ---- Papers: PDFs are fetched by scripts/fetch_papers.py ----
# manifest.json (with sha256) stays tracked so the fetch can be verified.
papers/*.pdf

# ---- OS and editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- NOT ignored on purpose ----
# results/ and results/tables.md must stay tracked: reviewers check them.
